filters:
  and:
    - file.hasTag("#journalNoteType")
properties:
  file.name:
    displayName: Note
views:
  - type: table
    name: Journal Notes
    order:
      - file.name
    sort:
      - property: tags
        direction: ASC
      - property: file.ctime
        direction: ASC
    limit: 10
    columnSize:
      file.name: 651
